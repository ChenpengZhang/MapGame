NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Real passwords belong only in backend/.env or server environment, NEVER in Git.
DATABASE_URL=postgresql://mapgame:replace_me@127.0.0.1:5432/mapgame
# Optional: existing maintenance DB on the same server, with CREATEDB privileges.
# Used only if the target database does not exist; never committed with real credentials.
DATABASE_ADMIN_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8080
# production: PUBLIC_ORIGIN=https://zcpenguin.com
# preview（写文件，仅开发）| smtp | ses（腾讯云邮件推送 API）
MAIL_TRANSPORT=preview
MAIL_FROM=
# --- SMTP 发信（MAIL_TRANSPORT=smtp 时必填）---
# 注意：腾讯云个人实名认证账号已被禁止通过 SMTP 发信，会直接报错；请改用下面的 ses 模式。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# --- 腾讯云邮件推送 API 发信（MAIL_TRANSPORT=ses 时必填）---
# 密钥在「访问管理 CAM → API 密钥管理」创建；建议用子账号，只授予 SES 发信权限。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 发信域名所在地域，控制台「邮件推送」页面可见（如 ap-guangzhou / ap-hongkong）
TENCENT_SES_REGION=
# 控制台「邮件推送 → 模板管理」创建的模板 ID；模板变量用 {{action}} 与 {{code}}
TENCENT_SES_TEMPLATE_ID=
