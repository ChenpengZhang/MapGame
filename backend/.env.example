NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Real passwords belong only in backend/.env or server environment, NEVER in Git.
DATABASE_URL=postgresql://mapgame:replace_me@127.0.0.1:5432/mapgame
# Optional: existing maintenance DB on the same server, with CREATEDB privileges.
# Used only if the target database does not exist; never committed with real credentials.
DATABASE_ADMIN_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8080
# production: PUBLIC_ORIGIN=https://zcpenguin.com
MAIL_TRANSPORT=preview
# Production must use smtp; preview files contain secret links and are gitignored.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
